{
  "name": "cards-of-the-canons",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-seo.mjs && node scripts/check-dist.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "artifact:check": "node scripts/check-dist.mjs",
    "performance:check": "node scripts/check-performance-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=1",
    "test:ci": "vitest run --maxWorkers=1",
    "test:functions": "npm --prefix functions test",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start",
    "emulators:export": "firebase emulators:export .firebase-data",
    "rules:test": "firebase emulators:exec --project demo-doxa-treasury --only firestore,auth,storage \"vitest run --config vitest.rules.config.ts\"",
    "release:config": "node scripts/validate-release-config.mjs --production",
    "release:check": "node scripts/run-release-checks.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.544.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.3",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-tools": "^15.32.1",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "exegesis@4.3.0": {
      "body-parser": "1.20.9"
    },
    "express@4.22.3": {
      "body-parser": "1.20.9"
    },
    "express@5.2.1": {
      "body-parser": "2.4.0"
    },
    "firebase-tools": {
      "@modelcontextprotocol/sdk": "1.32.2"
    }
  }
}
