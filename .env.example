# Demo mode is the safe default. Set to firebase only after configuring emulators or a Firebase web app.
VITE_DATA_MODE=demo
VITE_USE_FIREBASE_EMULATORS=true
# Use only when Java/Firestore emulator is unavailable. Auth remains real and persistent locally;
# private profile fields that require Firestore are deferred.
VITE_AUTH_ONLY_LOCAL=false
VITE_ENABLE_GOOGLE_AUTH=true
# Requires Apple Developer Service ID, Team ID, Key ID and private key configuration.
VITE_ENABLE_APPLE_AUTH=false
# Trusted administrator callables are available by default. Set false only for an intentional offline build.
VITE_ADMIN_FUNCTIONS_AVAILABLE=true
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-me
VITE_FIREBASE_STORAGE_BUCKET=replace-me.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me
# Public score-based reCAPTCHA Enterprise site key used by Firebase App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=replace-me
# Fail-closed storefront state. Use test only for an approved tester build.
# Use live only after credentials, webhook evidence, stock, shipping and
# policies pass the launch checklist; missing/invalid values disable checkout.
VITE_CHECKOUT_STATE=disabled
# Analytics is opt-in and off by default on both sides: this flag plus the
# server-side ANALYTICS_ENABLED parameter must both be enabled explicitly.
# There is no measurement ID; events are stored in Firestore, never forwarded.
VITE_ANALYTICS_ENABLED=false
# Preferred public origin used by canonical URLs, Open Graph and sitemap output.
# Change this to the approved custom domain before launch; do not include a trailing slash.
VITE_PUBLIC_SITE_URL=https://doxatreasury.com
# Keep false while catalogue content, prices and imagery are provisional. Enable only
# after John approves the real published catalogue for search and product structured data.
VITE_INDEX_PRODUCTS=false
